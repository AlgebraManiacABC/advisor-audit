# Copy to .env (gitignored). The deploy script copies it to the server with owner-only permissions.
MODEL_PROVIDER=akamai
OPENAI_BASE_URL=https://ws.akamai-workshops.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=hackathon-chat
MAX_TOKENS=4096
MODEL_TIMEOUT_SECONDS=90
# For a self-hosted model instead: MODEL_PROVIDER=ollama, OLLAMA_HOST=http://ollama:11434, OLLAMA_MODEL=qwen2.5:14b-instruct
RULES_FALLBACK=1
# Hostname Caddy gets a certificate for (DNS-only record pointing at the Linode)
DOMAIN=
